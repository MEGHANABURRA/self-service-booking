{
  "info": {
    "name": "host-service",
    "description": "Host availability / config service. Auth is handled by the upstream interceptor; this collection simulates it by sending x-user-id and x-user-role headers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "hostId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "hostRole",
      "value": "HOST"
    },
    {
      "key": "bookingId",
      "value": "d0000000-0000-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "1. Set availability (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 created\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{hostId}}"
          },
          {
            "key": "x-user-role",
            "value": "{{hostRole}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/availability?replace=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hosts",
            "{{hostId}}",
            "availability"
          ],
          "query": [
            {
              "key": "replace",
              "value": "false"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"days\": [\n    {\n      \"day\": \"MON\",\n      \"startTime\": \"10:00\",\n      \"endTime\": \"18:00\"\n    },\n    {\n      \"day\": \"TUE\",\n      \"startTime\": \"09:00\",\n      \"endTime\": \"13:00\"\n    },\n    {\n      \"day\": \"WED\",\n      \"startTime\": \"12:00\",\n      \"endTime\": \"20:00\"\n    }\n  ],\n  \"slotDurationMins\": 30,\n  \"gracePeriodMins\": 15,\n  \"maxBookingsPerDay\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Each day has its own UTC start/end time and repeats every week. slotDurationMins, gracePeriodMins and maxBookingsPerDay are shared across the listed days. Add ?replace=true to soft-delete weekdays not listed."
      }
    },
    {
      "name": "2a. Get available slots - single date (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 ok\", () => pm.response.to.have.status(200));",
              "pm.test(\"has days\", () => pm.expect(pm.response.json().days).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{hostId}}"
          },
          {
            "key": "x-user-role",
            "value": "{{hostRole}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/availability?date=2030-01-07",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hosts",
            "{{hostId}}",
            "availability"
          ],
          "query": [
            {
              "key": "date",
              "value": "2030-01-07"
            }
          ]
        },
        "description": "Dates are UTC calendar dates. Change the date to a weekday the host works on. The seeded bookings are on the next Monday (see seed output)."
      }
    },
    {
      "name": "2b. Get available slots - date range (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{hostId}}"
          },
          {
            "key": "x-user-role",
            "value": "{{hostRole}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/availability?from=2030-01-07&to=2030-01-11",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hosts",
            "{{hostId}}",
            "availability"
          ],
          "query": [
            {
              "key": "from",
              "value": "2030-01-07"
            },
            {
              "key": "to",
              "value": "2030-01-11"
            }
          ]
        }
      }
    },
    {
      "name": "3. Get host bookings (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json().bookings || [];",
              "if (b.length) pm.collectionVariables.set(\"bookingId\", b[0].bookingId);",
              "pm.test(\"200 ok\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{hostId}}"
          },
          {
            "key": "x-user-role",
            "value": "{{hostRole}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/bookings?status=BOOKED&page=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hosts",
            "{{hostId}}",
            "bookings"
          ],
          "query": [
            {
              "key": "status",
              "value": "BOOKED"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "4. Cancel a booking (DELETE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 or 409\", () => pm.expect([200, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-user-id",
            "value": "{{hostId}}"
          },
          {
            "key": "x-user-role",
            "value": "{{hostRole}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hosts",
            "{{hostId}}",
            "bookings",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Host unavailable\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Host-side cancellation. Sets status=CANCELLED, so the slot shows up as available again. A second call returns 409."
      }
    },
    {
      "name": "Negative examples",
      "item": [
        {
          "name": "Candidate role -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{hostId}}"
              },
              {
                "key": "x-user-role",
                "value": "CANDIDATE"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hosts",
                "{{hostId}}",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "Different host id -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "22222222-2222-4222-8222-222222222222"
              },
              {
                "key": "x-user-role",
                "value": "HOST"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hosts",
                "{{hostId}}",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "Invalid slot duration -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{hostId}}"
              },
              {
                "key": "x-user-role",
                "value": "{{hostRole}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hosts/{{hostId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hosts",
                "{{hostId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": [\n    {\n      \"day\": \"MON\",\n      \"startTime\": \"10:00\",\n      \"endTime\": \"18:00\"\n    }\n  ],\n  \"slotDurationMins\": 20,\n  \"maxBookingsPerDay\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}